# Thinx - environment template
# Copy to .env and fill in. Never commit .env.
#
# Only the variables listed here are read. The previous template documented about
# forty settings that the compose file never passed to any container, which meant
# operators believed they had configured things they had not (assessment finding L2).

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# Signs the session cookie. Without it the API refuses to start in production.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# AllegroGraph administrator password. Used both to initialise the database
# container and by the backend. Set it before the first start: it is applied
# when the data volume is created and is not changed by editing it later.
AGRAPH_SUPER_PASSWORD=

# ---------------------------------------------------------------------------
# DEPLOYMENT
# ---------------------------------------------------------------------------

# Which services to start: full (with AI), no-ai, minimal.
COMPOSE_PROFILES=full

# Interface the published ports bind to. Keep 127.0.0.1 and put a TLS reverse
# proxy in front for anything that other people need to reach; Docker publishes
# past the host firewall (finding M3).
BIND_HOST=127.0.0.1

# production keeps the Werkzeug debugger off (finding H2). Only use development
# on a laptop that nothing else can reach.
FLASK_ENV=production
FLASK_DEBUG=0

# Where the browser reaches the API, baked into the frontend at build time.
VITE_API_URL=http://localhost:5000

# Browser origins allowed to call the API. Must match how people open the UI.
CORS_ORIGINS=http://localhost:8080

# Set to true once the stack is served over HTTPS, so the session cookie is
# only ever sent over TLS.
SESSION_COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# ACCOUNTS
# ---------------------------------------------------------------------------

# The first account that registers becomes the administrator. Set this to false
# afterwards so that only administrators can add accounts.
ALLOW_REGISTRATION=true

# Minimum password length enforced by the API.
MIN_PASSWORD_LENGTH=12

# Session lifetime in seconds.
SESSION_TIMEOUT=3600

# ---------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------

# AllegroGraph connection defaults used by the backend and the helper scripts.
AGRAPH_HOST=allegrograph
AGRAPH_PORT=10035
AGRAPH_REPOSITORY=humantrafficking
AGRAPH_SUPER_USER=admin
